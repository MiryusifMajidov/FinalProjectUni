<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own launch splash; give it the app's felt
         instead of the system's white / black, so opening the app is one
         colour from the icon tap to the first screen. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/app_ground</item>
        <item name="android:navigationBarColor">@color/app_ground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/app_ground</item>
        <item name="android:navigationBarColor">@color/app_ground</item>
    </style>
</resources>
