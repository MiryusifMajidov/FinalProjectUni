rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth()          { return request.auth != null; }
    function isOwner(uid)      { return request.auth.uid == uid; }
    function isAdmin()         { return request.auth.token.email == 'miryusifmcidov089@gmail.com'; }
    function affectedKeys()    { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && !affectedKeys().hasAny([
            'bulletStats', 'blitzStats', 'rapidStats'
           ]);
      allow delete: if isOwner(userId);

      // Friends subcollection — both sides write during accept/remove
      match /friends/{friendId} {
        allow read: if isAuth();
        allow create, delete: if isAuth()
          && (isOwner(userId) || request.auth.uid == friendId);
        allow update: if false;
      }
    }

    // ── Usernames (uniqueness registry) ──────────────────────────────────────
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // ── OTP codes ─────────────────────────────────────────────────────────────
    match /emailOtps/{emailKey} {
      allow read, write: if false;
    }

    // ── Sessions ──────────────────────────────────────────────────────────────
    match /sessions/{userId}/devices/{sessionId} {
      allow read, write: if isOwner(userId);
    }

    // ── Games ─────────────────────────────────────────────────────────────────
    match /games/{gameId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && (request.resource.data.whiteUid == request.auth.uid
            || request.resource.data.blackUid == request.auth.uid);
      // Rating fields are locked only AFTER the chess Cloud Function has
      // stamped ratingProcessed (server-authoritative ELO). Before that —
      // and for checkers/domino, which never set the stamp — each client
      // writes its own side's before/change so the profile chart has data.
      allow update: if isAuth()
        && (resource.data.whiteUid == request.auth.uid
            || resource.data.blackUid == request.auth.uid)
        && !(resource.data.keys().hasAny(['ratingProcessed'])
             && resource.data.ratingProcessed == true
             && affectedKeys().hasAny([
                 'whiteRatingChange','blackRatingChange',
                 'whiteRatingBefore','blackRatingBefore'
                ]));
    }

    // ── Chats ─────────────────────────────────────────────────────────────────
    // chatId format: "uid1_uid2" (sorted).
    // `get`  uses chatId to verify the caller — works even when the
    //        document doesn't exist yet (first-time chat).
    // `list` uses resource.data.participants — compatible with the
    //        arrayContains queries used by watchChats / watchTotalUnread.
    match /chats/{chatId} {
      allow get: if isAuth()
        && (request.auth.uid == chatId.split('_')[0]
            || request.auth.uid == chatId.split('_')[1]);
      allow list: if isAuth()
        && request.auth.uid in resource.data.participants;
      allow create: if isAuth()
        && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth()
        && (request.auth.uid == chatId.split('_')[0]
            || request.auth.uid == chatId.split('_')[1]);
      allow delete: if false;

      match /messages/{messageId} {
        // Use chatId split instead of get() on parent — avoids failure
        // when the parent chat document hasn't been created yet.
        allow read: if isAuth()
          && (request.auth.uid == chatId.split('_')[0]
              || request.auth.uid == chatId.split('_')[1]);
        allow create: if isAuth()
          && (request.auth.uid == chatId.split('_')[0]
              || request.auth.uid == chatId.split('_')[1])
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Groups ────────────────────────────────────────────────────────────────
    match /groups/{groupId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth()
        && request.auth.uid in resource.data.memberIds;
      allow delete: if isAuth()
        && request.auth.uid == resource.data.creatorId;

      match /messages/{messageId} {
        allow read: if isAuth()
          && request.auth.uid in
             get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if isAuth()
          && request.auth.uid in
             get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Friend requests ───────────────────────────────────────────────────────
    match /friendRequests/{userId}/received/{fromUserId} {
      // Recipient reads all their incoming requests;
      // sender can read their own sent request (duplicate check).
      allow read: if isOwner(userId)
        || (isAuth() && fromUserId == request.auth.uid);
      allow create: if isAuth() && fromUserId == request.auth.uid;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId)
        || (isAuth() && fromUserId == request.auth.uid);
    }

    // ── Game invites ──────────────────────────────────────────────────────────
    match /gameInvites/{userId}/pending/{inviteId} {
      allow read: if isOwner(userId);
      allow create: if isAuth();
      allow delete: if isOwner(userId);
      allow update: if false;
    }

    // ── Arenas / Tournaments ──────────────────────────────────────────────────
    match /arenas/{arenaId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth()
        && resource.data.creatorUid == request.auth.uid;
      allow delete: if isAuth()
        && resource.data.creatorUid == request.auth.uid;
    }

    match /tournaments/{tournamentId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth()
        && resource.data.creatorUid == request.auth.uid;
      allow delete: if isAuth()
        && resource.data.creatorUid == request.auth.uid;

      match /participants/{participantId} {
        allow read: if isAuth();
        allow create: if isAuth() && participantId == request.auth.uid;
        allow delete: if isAuth() && participantId == request.auth.uid;
        allow update: if false;
      }
    }

    // ── Leaderboard (server-written, read-only for clients) ───────────────────
    match /leaderboard/{document=**} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── Map presence ──────────────────────────────────────────────────────────
    match /mapPresence/{userId} {
      allow read: if isAuth();
      allow write: if isOwner(userId);
    }

    // ── Feedback ──────────────────────────────────────────────────────────────
    match /feedback/{feedbackId} {
      allow create: if isAuth();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── Reports (user reports — create-only for clients) ──────────────────────
    // Moderation reads and resolves these server-side with the Admin SDK,
    // which bypasses these rules.
    match /reports/{reportId} {
      allow create: if isAuth()
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ── Logs ──────────────────────────────────────────────────────────────────
    match /logs/{logId} {
      allow create: if isAuth();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
