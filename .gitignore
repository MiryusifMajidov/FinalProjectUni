# .gitignore

# Build & generated
build/
.dart_tool/
.gradle/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/

# IDE
.idea/
.vscode/
*.iml

# Android (local paths / signing)
android/local.properties
android/.gradle/

# iOS — generated by Flutter / CocoaPods, NEVER commit
ios/Pods/
ios/.symlinks/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
**/DerivedData/

# Build outputs
*.apk
*.aab
*.ipa
*.zip

# Signing secrets — NEVER commit these
**/key.properties
*.jks
*.keystore
*.p12
*.mobileprovision

# App secrets (real values live in Firebase Secret Manager)
lib/core/config/secrets.dart

# OS
.DS_Store
